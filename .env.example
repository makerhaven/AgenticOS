# Agentic OS configuration — copy to .env and fill in. Never commit .env.

# Path to your Obsidian vault (plain markdown folder). A skeleton is created at ./vault by setup.
# In Docker this is /vault (bind-mounted from /srv/agentic-os/vault on the host).
VAULT_PATH=./vault

# Graphify sidecar (Docker compose sets this automatically to http://graphify:4747).
# Leave empty for the built-in local indexer (dev / non-Docker).
GRAPHIFY_URL=

# Model provider keys (all optional — the mock adapter runs the whole UI with zero keys)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Single-user lock. When set, /control requires this passcode.
CONTROL_PASSCODE=

# Concurrency guardrail for a 4-core box
MAX_CONCURRENT_RUNS=3

# Port
PORT=3737
